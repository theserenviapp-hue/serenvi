# ========== SECURITY CRITICAL ==========
# JWT - MUST be 32+ characters, unique, and kept secret!
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRATION="24h"

# ========== DATABASE ==========
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/serenvi_db"
# DIRECT_URL is optional - use if you have a connection pooler (PgBouncer, Supabase Pooling, etc)
# Leave as DATABASE_URL for local development
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/serenvi_db"

# ========== REDIS ==========
REDIS_URL="redis://localhost:6379"

# ========== SERVER ==========
PORT=3000
NODE_ENV="development"  # Set to "production" in production
FRONTEND_URL="http://localhost:3001"  # Comma-separated for multiple domains

# ========== PASSWORD REQUIREMENTS ==========
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=true

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5  # Login attempts

# ========== SECURITY FEATURES ==========
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_RATE_LIMITING=true
ENABLE_INPUT_SANITIZATION=true
ENABLE_AUDIT_LOGGING=true

# ========== LOGGING ==========
LOG_LEVEL="debug"  # Change to "warn" in production
LOG_AUDIT_TRAIL=true

# ========== EMAIL (REQUIRED for T-PIN, password reset) ==========
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
MAIL_HOST="smtp.gmail.com"
MAIL_FROM="noreply@serenvi.com"

# ========== PRODUCTION SECURITY CHECKLIST ==========
# □ Set JWT_SECRET to a strong 32+ character random value
# □ Use HTTPS URLs for all endpoints
# □ Enable DATABASE_SSL=true
# □ Set NODE_ENV=production
# □ Disable debug logging (LOG_LEVEL=warn)
# □ Implement 2FA for admin operations
# □ Regularly rotate JWT_SECRET
# □ Monitor rate limiting metrics
# □ Enable database backups
# □ Use environment variables for all secrets
# □ Run npm audit regularly
# □ Keep dependencies updated with: npm update
