generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  clerkId       String?  @unique
  memberId      String   @unique
  name          String
  email         String   @unique
  phone         String
  passwordHash  String?
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]   @relation("Referrals")
  rank          Rank     @default(NOT_ACHIEVED)
  status        Status   @default(ACTIVE)
  isAdmin       Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        Wallet?
  products      UserProduct[]
  bonuses       Bonus[]
  withdrawals   Withdrawal[]

  @@index([referredById])
  @@index([email])
  @@index([memberId])
  @@index([clerkId])
  @@index([createdAt])
  @@index([rank])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eWallet        Float    @default(0)
  topupWallet    Float    @default(0)
  shoppingFund   Float    @default(0)
  totalEarning   Float    @default(0)
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String?
  price       Float
  fileUrl     String
  isActive    Boolean         @default(true)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  purchases   UserProduct[]

  @@index([isActive])
  @@index([createdAt])
}

model UserProduct {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  paidVia     PayMethod
  utr         String?
  purchasedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Bonus {
  id        String    @id @default(cuid())
  userId    String
  type      BonusType
  amount    Float
  date      DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([date])
  @@index([userId, type])
  @@index([userId, date])
}

model Withdrawal {
  id           String              @id @default(cuid())
  userId       String
  amount       Float
  netAmount    Float
  bankDetails  Json
  status       WithdrawalStatus    @default(PENDING)
  utr          String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

enum Rank {
  NOT_ACHIEVED
  PERFORMER
  CHAMPION
  INFLUENCER
  GAMER
  WORLD_SHAKER
}

enum BonusType {
  FAST_TRACK
  STEP_UP
  TALENT_DIVIDEND
  LEADERSHIP
  RANK
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PayMethod {
  BANK
  ADMIN_FREE
  WALLET
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}
